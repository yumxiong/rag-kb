# 安全配置示例 - 不包含明文API Key

# Application Configuration  
APP_NAME=RAG Knowledge Base
APP_VERSION=1.0.0
DEBUG=False
ENABLE_API_DOCS=False
TEMP_UPLOAD_DIR=./data/tmp_uploads
ALLOWED_ORIGINS=http://localhost:8501,http://127.0.0.1:8501

LLM_PROVIDER=openai
EMBEDDING_PROVIDER=openai
CHAT_MODEL=gpt-3.5-turbo
EMBEDDING_MODEL=text-embedding-ada-002
# API_KEY=
# EMBEDDING_API_KEY=
# 跨提供商时分别填写聊天和嵌入 Key；可改用对应 *_FILE。
# 管理员登录可选配置：JWT_SECRET、ADMIN_PASSWORD_HASH。

# Storage Configuration
UPLOAD_DIR=./data/uploads
CHROMA_DB_PATH=./data/chroma_db

# API Configuration
BACKEND_HOST=127.0.0.1
BACKEND_PORT=8000
FRONTEND_HOST=127.0.0.1
FRONTEND_PORT=8501

# RAG Configuration
CHUNK_SIZE=1000
CHUNK_OVERLAP=200
MAX_SOURCES=3
# Chroma 距离阈值，越小越相似，不是百分比
SIMILARITY_THRESHOLD=1.5

# 安全的API Key配置方式 (选择其中一种)

# 方式1: 从文件读取 (推荐用于开发环境)
# OPENAI_API_KEY_FILE=./secrets/openai_api_key/deepseek_api_key

# 方式2: Base64编码的环境变量（仅编码，不是加密）
# OPENAI_API_KEY_BASE64=your_base64_encoded_key_here

# 方式3: 系统环境变量 (最推荐)
# 在系统级别设置: export OPENAI_API_KEY="your-key"
# 无需在此文件中配置

# 注意: Docker Secrets会自动从 /run/secrets/openai_api_key/deepseek_api_key 读取