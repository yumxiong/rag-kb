# Model and retrieval settings only; NOT a complete production configuration.
# No credentials: initialize separate server-side secrets at deployment step 8.
LLM_PROVIDER=deepseek
CHAT_MODEL=deepseek-flash
API_BASE_URL=https://api.deepseek.com
EMBEDDING_PROVIDER=qwen
EMBEDDING_MODEL=text-embedding-v3
