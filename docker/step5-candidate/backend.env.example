# Reviewed provider choices; real provider/new image acceptance still pending.
# New source enforces a separate fixed CNY 50 reservation cap per UTC day.
# Price policy expires 2026-10-23 UTC; see step5-money-admission.md.
# Old accepted images do not contain this monetary guard.
# Store actual secrets outside Git, with restrictive host permissions.
DEBUG=false
ENABLE_API_DOCS=false
ENABLE_DOCUMENT_MAINTENANCE=false
LLM_PROVIDER=deepseek
EMBEDDING_PROVIDER=qwen
API_BASE_URL=https://api.deepseek.com
EMBEDDING_API_BASE_URL=https://dashscope.aliyuncs.com/compatible-mode/v1
CHAT_MODEL=deepseek-flash
EMBEDDING_MODEL=qwen3.7-text-embedding
EMBEDDING_DIMENSIONS=1024
EMBEDDING_INDEX_VERSION=1
API_KEY_FILE=/run/secrets/chat_api_key
EMBEDDING_API_KEY_FILE=/run/secrets/embedding_api_key
JWT_SECRET_FILE=/run/secrets/jwt_secret
ADMIN_PASSWORD_HASH_FILE=/run/secrets/admin_password_hash
# Accepted count limits remain independent of monetary admission.
DEFAULT_DAILY_QUOTA=5
GLOBAL_DAILY_ASK_LIMIT=500
GLOBAL_DAILY_DEFAULT_LLM_LIMIT=200
GLOBAL_DAILY_LLM_LIMIT=500
GLOBAL_DAILY_QUERY_EMBEDDING_LIMIT=1000
QUOTA_TIMEZONE=UTC
LLM_MAX_TOKENS=800
QUESTION_DEADLINE_SECONDS=60
EMBEDDING_TIMEOUT_SECONDS=15
CHAT_TIMEOUT_SECONDS=45
MAX_CONCURRENT_REQUESTS=20
MAX_CONCURRENT_IDENTITY_QUESTIONS=1
