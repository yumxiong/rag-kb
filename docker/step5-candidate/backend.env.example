# Draft only: replace provider/model placeholders before separately authorized use.
# Store actual secrets outside Git, with restrictive host permissions.
DEBUG=false
ENABLE_API_DOCS=false
ENABLE_DOCUMENT_MAINTENANCE=false
LLM_PROVIDER=REPLACE_WITH_REVIEWED_PROVIDER
EMBEDDING_PROVIDER=REPLACE_WITH_REVIEWED_PROVIDER
API_BASE_URL=REPLACE_WITH_REVIEWED_HTTPS_ENDPOINT
EMBEDDING_API_BASE_URL=REPLACE_WITH_REVIEWED_HTTPS_ENDPOINT
CHAT_MODEL=REPLACE_WITH_REVIEWED_MODEL
EMBEDDING_MODEL=REPLACE_WITH_REVIEWED_MODEL
API_KEY_FILE=/run/secrets/chat_api_key
EMBEDDING_API_KEY_FILE=/run/secrets/embedding_api_key
JWT_SECRET_FILE=/run/secrets/jwt_secret
ADMIN_PASSWORD_HASH_FILE=/run/secrets/admin_password_hash
# Existing repository defaults; confirm the operating budget before deployment.
DEFAULT_DAILY_QUOTA=5
GLOBAL_DAILY_ASK_LIMIT=500
GLOBAL_DAILY_DEFAULT_LLM_LIMIT=200
GLOBAL_DAILY_LLM_LIMIT=500
GLOBAL_DAILY_QUERY_EMBEDDING_LIMIT=1000
QUOTA_TIMEZONE=UTC
QUESTION_DEADLINE_SECONDS=60
EMBEDDING_TIMEOUT_SECONDS=15
CHAT_TIMEOUT_SECONDS=45
MAX_CONCURRENT_REQUESTS=20
MAX_CONCURRENT_IDENTITY_QUESTIONS=1
