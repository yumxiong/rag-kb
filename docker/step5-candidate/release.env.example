# Non-secret interpolation inputs ONLY. Copy outside the repository after review.
# Absolute Linux target path is a proposal, not an existing/provisioned directory.
DEPLOY_ROOT=/opt/rag-kb
BACKEND_IMAGE=REPLACE_WITH_ACCEPTED_BACKEND_REFERENCE
STREAMLIT_IMAGE=REPLACE_WITH_ACCEPTED_STREAMLIT_REFERENCE
NEXT_IMAGE=REPLACE_WITH_ACCEPTED_NEXT_REFERENCE
NGINX_IMAGE=REPLACE_WITH_REVIEWED_NGINX_1_28_REFERENCE
CERTBOT_IMAGE=REPLACE_WITH_REVIEWED_CERTBOT_REFERENCE
# Obtain from the actual Linux container mountinfo, never copy a Windows test value.
ANONYMOUS_MOUNT_SOURCE=REPLACE_WITH_VERIFIED_SOURCE
BIND_IP=0.0.0.0
HTTP_PORT=80
HTTPS_PORT=443
